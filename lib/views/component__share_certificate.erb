<div class="component__print govuk-!-display-none-print">

  <h2 class="govuk-heading-m"><%= t("component.share.share_#{type}")%></h2>

  <ul class="epb-share-list">
    <li class="epb-share-list__item">
      <a href="mailto:?subject=<%="#{ERB::Util.url_encode("#{t("#{top_heading}.top_heading")} #{t("component.share.email_subject_for")} #{find_address_lines_only(assessment)}")}&body=#{ERB::Util.url_encode("#{t("component.share.email_body_part_1")} #{first_word_downcase(t("#{top_heading}.top_heading"))} #{t("component.share.email_body_part_2")} https://find-energy-certificate.service.gov.uk/energy-certificate/#{assessment[:assessmentId]}")}"%>"
         class="epb-share-list__link"
      >
        <%== inline_svg('/images/email.svg') %>
        <%= t("component.share.email")%>
      </a>
    </li>
    <li class="epb-share-list__item hide-no-js">
      <script type="module" src="<%= assets_path('/javascript/copy-url-to-clipboard.js') %>" nonce="<%= script_nonce %>"></script>
      <epb-copy-url-to-clipboard>
        <button type="button" class="govuk-link epb-copy-button epb-share-list__link">
          <slot name="action-message" class="epb-copy-button__label">
            <%== inline_svg('/images/copy-link.svg') %>
            <%= t("component.share.copy_link") %>
          </slot>
          <slot name="success-message" class="epb-copy-button__label" hidden>
            <%== inline_svg('/images/check.svg') %>
            <%= t("component.share.copied") %>
          </slot>
        </button>
      </epb-copy-url-to-clipboard>
    </li>
    <li class="epb-share-list__item hide-no-js">
      <a rel="nofollow"
         href="<%= localised_url(request.path_info) + (localised_url(request.path_info).include?("?") ? "&" : "?") %>print=true"
         class="epb-share-list__link"
      >
        <%== inline_svg('/images/print.svg') %>
        <%= t("component.share.print_link")%>
      </a>
    </li>
  </ul>
</div>
